WEATHER_PLATFORM_ROOT=data/platform
SPARK_MASTER=local[4]
SPARK_PARTITIONS=8

# Ask weather: server only; never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Local demo uses your Codex ChatGPT sign-in. Set openai to use API billing instead.
WEATHER_AI_PROVIDER=codex
# Optional Codex model override; omitted uses the installed CLI default.
# WEATHER_CODEX_MODEL=
